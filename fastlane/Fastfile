opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Build and upload Rosetta to TestFlight"

  lane :beta do
    # ---------------------------------------------------------
    # Configuration provided by GitHub Actions
    # ---------------------------------------------------------
    bundle_id = ENV.fetch(
      "APP_BUNDLE_ID",
      "com.academy.hendraaaa.Rosetta"
    )

    team_id = ENV.fetch("PROFILE_TEAM_ID")
    profile_name = ENV.fetch("PROFILE_NAME")
    profile_uuid = ENV.fetch("PROFILE_UUID")

    app_store_app_id = ENV.fetch("APP_STORE_APP_ID")
    github_run_number = ENV.fetch("GITHUB_RUN_NUMBER")

    UI.message("Preparing Rosetta TestFlight build")
    UI.message("Bundle ID: #{bundle_id}")
    UI.message("Team ID: #{team_id}")
    UI.message("Provisioning profile: #{profile_name}")
    UI.message("Provisioning profile UUID: #{profile_uuid}")
    UI.message("Build number: #{github_run_number}")

    # ---------------------------------------------------------
    # Authenticate with App Store Connect API
    # ---------------------------------------------------------
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    # ---------------------------------------------------------
    # Use GitHub Actions run number as the application build
    # number so every uploaded build is unique
    # ---------------------------------------------------------
    increment_build_number(
      xcodeproj: "Rosetta.xcodeproj",
      build_number: github_run_number
    )

    # ---------------------------------------------------------
    # Build and archive the application using manual signing
    # ---------------------------------------------------------
    build_app(
      project: "Rosetta.xcodeproj",
      scheme: "Rosetta",
      configuration: "Release",
      clean: true,

      destination: "generic/platform=iOS",

      output_directory: "build",
      output_name: "Rosetta.ipa",

      export_method: "app-store",
      skip_profile_detection: true,

      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
        "CODE_SIGN_STYLE=Manual",
        'CODE_SIGN_IDENTITY="Apple Distribution"',
        "PROVISIONING_PROFILE=#{profile_uuid}",
        "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\""
      ].join(" "),

      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          bundle_id => profile_name
        }
      }
    )

    # ---------------------------------------------------------
    # Confirm that the IPA was generated
    # ---------------------------------------------------------
    ipa_path = File.expand_path(
      "../build/Rosetta.ipa",
      __dir__
    )

    unless File.exist?(ipa_path)
      UI.user_error!(
        "Rosetta IPA was not found at #{ipa_path}"
      )
    end

    UI.success("Rosetta IPA generated at #{ipa_path}")

    # ---------------------------------------------------------
    # Upload the generated IPA to TestFlight
    # ---------------------------------------------------------
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      apple_id: app_store_app_id,
      ipa: ipa_path,
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )

    UI.success(
      "Rosetta build #{github_run_number} was uploaded to TestFlight"
    )
  end
end
